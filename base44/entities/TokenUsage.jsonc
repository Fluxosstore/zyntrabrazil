{
  "name": "TokenUsage",
  "type": "object",
  "properties": {
    "tokens": {
      "type": "number",
      "description": "Quantidade de cr\u00e9ditos consumidos neste registro"
    },
    "model": {
      "type": "string",
      "description": "Modelo de IA usado (ex: gpt, claude, gemini)"
    },
    "prompt": {
      "type": "string",
      "description": "Texto do comando enviado pelo usu\u00e1rio"
    },
    "category": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "audio"
      ],
      "description": "Categoria do consumo (texto, imagem ou \u00e1udio)"
    }
  },
  "required": [
    "tokens"
  ]
}