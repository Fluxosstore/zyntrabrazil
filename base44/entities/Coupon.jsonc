{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo do cupom"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do cupom"
    },
    "discount_type": {
      "type": "string",
      "description": "Tipo de desconto",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent"
    },
    "discount_value": {
      "type": "number",
      "description": "Valor do desconto (percentual ou fixo em reais)"
    },
    "max_uses": {
      "type": "number",
      "description": "N\u00famero m\u00e1ximo de usos",
      "default": 100
    },
    "uses": {
      "type": "number",
      "description": "Quantas vezes j\u00e1 foi usado",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "description": "Se o cupom est\u00e1 ativo",
      "default": true
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Data de expira\u00e7\u00e3o do cupom"
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value",
    "active"
  ]
}