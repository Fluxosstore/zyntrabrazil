{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan": {
      "type": "string",
      "description": "The subscription plan of the user",
      "enum": [
        "free",
        "starter",
        "premium",
        "team",
        "startup",
        "enterprise"
      ],
      "default": "free"
    },
    "balance": {
      "type": "number",
      "description": "Saldo de tokens do usu\u00e1rio",
      "default": 0
    },
    "blocked": {
      "type": "boolean",
      "description": "Se o usu\u00e1rio est\u00e1 bloqueado",
      "default": false
    }
  },
  "required": [
    "role"
  ]
}