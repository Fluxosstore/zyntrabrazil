{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan": {
      "type": "string",
      "description": "The subscription plan of the user",
      "enum": [
        "free",
        "starter",
        "premium",
        "team",
        "startup",
        "enterprise"
      ],
      "default": "free"
    },
    "plan_cycle": {
      "type": "string",
      "description": "Ciclo de cobran\u00e7a do plano",
      "enum": [
        "mensal",
        "anual"
      ],
      "default": "mensal"
    },
    "plan_subscribed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data em que o plano atual foi assinado"
    },
    "plan_expires": {
      "type": "string",
      "format": "date",
      "description": "Data de expira\u00e7\u00e3o do plano atual"
    },
    "auto_renew": {
      "type": "boolean",
      "description": "Se a renova\u00e7\u00e3o autom\u00e1tica est\u00e1 ativa",
      "default": true
    },
    "balance": {
      "type": "number",
      "description": "Saldo de tokens do usu\u00e1rio",
      "default": 0
    },
    "blocked": {
      "type": "boolean",
      "description": "Se o usu\u00e1rio est\u00e1 bloqueado",
      "default": false
    }
  },
  "required": [
    "role"
  ]
}